{
  "name": "Item",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Title"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "price": {
      "type": "number",
      "title": "Price (ETB, manual)",
      "minimum": 0
    },
    "price_aed": {
      "type": "number",
      "title": "Price in AED (Dirham, manual)",
      "minimum": 0
    },
    "purchase_price": {
      "type": "number",
      "title": "Purchase price (AED)",
      "minimum": 0
    },
    "shipping_fee": {
      "type": "number",
      "title": "Shipping fee (AED)",
      "minimum": 0,
      "default": 0
    },
    "profit_margin": {
      "type": "number",
      "title": "Profit margin (%)",
      "minimum": 0,
      "maximum": 500,
      "default": 0
    },
    "picker_delivery_fee": {
      "type": "number",
      "title": "Picker delivery fee (ETB)",
      "minimum": 0,
      "default": 0
    },
    "discounted_price": {
      "type": "number",
      "title": "Discounted Price (ETB)",
      "minimum": 0
    },
    "discount_percent": {
      "type": "number",
      "title": "Per-item Discount (%)",
      "minimum": 0,
      "maximum": 100,
      "default": 0
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Image URLs"
    },
    "category": {
      "type": "string",
      "title": "Category",
      "enum": [
        "Electronics",
        "Fashion",
        "Home & Living",
        "Beauty & Health",
        "Groceries",
        "Kids",
        "Other"
      ]
    },
    "stock": {
      "type": "integer",
      "title": "Stock",
      "minimum": 0,
      "default": 1
    },
    "is_offer": {
      "type": "boolean",
      "title": "Is Offer",
      "default": false
    },
    "is_deal": {
      "type": "boolean",
      "title": "Is Deal of the Day",
      "default": false
    },
    "offer_label": {
      "type": "string",
      "title": "Offer Label (e.g. 30% OFF)"
    },
    "status": {
      "type": "string",
      "title": "Verification Status",
      "enum": [
        "draft",
        "verified",
        "published"
      ],
      "default": "draft"
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.status": "published"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}