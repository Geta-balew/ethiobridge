{
  "name": "Order",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "integer"
          },
          "image": {
            "type": "string"
          }
        }
      },
      "title": "Items"
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal (ETB)"
    },
    "delivery_fee": {
      "type": "number",
      "title": "Delivery Fee (ETB)",
      "default": 0
    },
    "picker_fee": {
      "type": "number",
      "title": "Picker Service Fee (ETB)",
      "default": 0
    },
    "coupon_code": {
      "type": "string",
      "title": "Coupon Code"
    },
    "coupon_discount": {
      "type": "number",
      "title": "Coupon Discount (ETB)",
      "default": 0
    },
    "total": {
      "type": "number",
      "title": "Total (ETB)"
    },
    "buyer_name": {
      "type": "string",
      "title": "Full Name"
    },
    "buyer_phone": {
      "type": "string",
      "title": "Primary Phone"
    },
    "buyer_alt_phone": {
      "type": "string",
      "title": "Alternative Phone"
    },
    "buyer_email": {
      "type": "string",
      "title": "Email"
    },
    "delivery_address": {
      "type": "string",
      "title": "Delivery Address"
    },
    "delivery_city": {
      "type": "string",
      "title": "Delivery City"
    },
    "delivery_region": {
      "type": "string",
      "title": "Delivery Region"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "manual"
      ],
      "title": "Payment Method"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "manual_pending",
        "manual_confirmed"
      ],
      "default": "manual_pending",
      "title": "Payment Status"
    },
    "payment_screenshot": {
      "type": "string",
      "title": "Payment Screenshot URL"
    },
    "chapa_tx_ref": {
      "type": "string",
      "title": "Chapa Transaction Reference"
    },
    "preferred_picker_id": {
      "type": "string",
      "title": "Preferred Picker (user id)"
    },
    "picker_id": {
      "type": "string",
      "title": "Assigned Picker User ID"
    },
    "requested_picker_id": {
      "type": "string",
      "title": "Picker who requested to pick"
    },
    "pick_request_status": {
      "type": "string",
      "enum": [
        "none",
        "requested",
        "approved",
        "rejected"
      ],
      "default": "none",
      "title": "Pick Request Status"
    },
    "pick_request_trips": {
      "type": "integer",
      "title": "Picker's prior Dubai trips",
      "default": 0
    },
    "picker_ticket_number": {
      "type": "string",
      "title": "Picker ticket number"
    },
    "picker_airline": {
      "type": "string",
      "title": "Picker airline"
    },
    "picker_ticket_image": {
      "type": "string",
      "title": "Picker ticket screenshot"
    },
    "picker_arrival_location": {
      "type": "string",
      "title": "Addis Ababa arrival location"
    },
    "picker_status": {
      "type": "string",
      "enum": [
        "unassigned",
        "claimed",
        "picked",
        "in_transit",
        "delivered",
        "cancelled"
      ],
      "default": "unassigned",
      "title": "Picker Status"
    },
    "delivery_code": {
      "type": "string",
      "title": "Delivery Confirmation Code"
    },
    "buyer_rated": {
      "type": "boolean",
      "title": "Buyer left a review",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "placed",
        "verified",
        "delivered",
        "cancelled"
      ],
      "default": "placed",
      "title": "Order Status"
    }
  },
  "required": [
    "items",
    "total",
    "buyer_name",
    "buyer_phone",
    "delivery_address",
    "payment_method"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.picker_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.picker_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}