{
  "name": "Picker",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "passport_number": {
      "type": "string",
      "title": "Passport Number"
    },
    "passport_image": {
      "type": "string",
      "title": "Passport Image URL"
    },
    "national_id_number": {
      "type": "string",
      "title": "Ethiopian National ID Number"
    },
    "national_id_image": {
      "type": "string",
      "title": "National ID Image URL"
    },
    "dubai_residence_permit": {
      "type": "string",
      "title": "Dubai Residence Permit / Visa Image URL"
    },
    "flight_date": {
      "type": "string",
      "format": "date",
      "title": "Next Flight Date"
    },
    "flight_ticket_image": {
      "type": "string",
      "title": "Flight Ticket Photo URL"
    },
    "previous_trips_count": {
      "type": "integer",
      "title": "Previous Trips to Dubai",
      "default": 0,
      "minimum": 0
    },
    "first_time_status": {
      "type": "string",
      "enum": [
        "first_time_traveler",
        "occasional_traveler",
        "frequent_traveler",
        "business_traveler"
      ],
      "default": "first_time_traveler",
      "title": "Traveler Status (customs risk)"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "rejected"
      ],
      "default": "pending",
      "title": "Verification Status"
    },
    "verified_by_id": {
      "type": "string",
      "title": "Verified By Admin ID"
    },
    "rejection_reason": {
      "type": "string",
      "title": "Rejection Reason"
    },
    "bio": {
      "type": "string",
      "title": "Bio"
    },
    "rating": {
      "type": "number",
      "title": "Rating",
      "default": 0
    },
    "total_deliveries": {
      "type": "integer",
      "title": "Total Deliveries",
      "default": 0
    },
    "bank_account": {
      "type": "string",
      "title": "Bank Account (for payout)"
    }
  },
  "required": [
    "full_name",
    "phone",
    "passport_number",
    "national_id_number",
    "flight_date",
    "previous_trips_count"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}